# Server
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/pottery_ecommerce

# JWT
JWT_SECRET=replace_with_a_long_random_secret_key
JWT_EXPIRE=7d
JWT_COOKIE_EXPIRE=7

JWT_REFRESH_SECRET=replace_with_another_long_random_secret_key
JWT_REFRESH_EXPIRE=30d

# Cloudinary (for product image uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Stripe (for payments)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Email (Nodemailer - for order confirmations / password reset)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=youremail@gmail.com
SMTP_PASSWORD=your_app_password
FROM_NAME=Earthen & Co. Pottery
FROM_EMAIL=noreply@earthenpottery.com
