# Charu Pottery API — copy to .env and fill in. Never commit real values.

NODE_ENV=development            # production on the live server
PORT=5000
# Exact origins allowed by CORS (comma-separated). Storefront and admin.
CLIENT_URL=http://localhost:3000
ADMIN_URL=
# Public storefront URL (used for PhonePe redirect back to /order-success/:id)
PUBLIC_STOREFRONT_URL=http://localhost:3000

# MongoDB — MUST be a replica set (Atlas is) for checkout/stock transactions.
# Local example: mongodb://127.0.0.1:27017/charu_pottery?replicaSet=rs0
MONGO_URI=

# JWT — long random strings (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`)
JWT_SECRET=
JWT_EXPIRE=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRE=30d
JWT_COOKIE_EXPIRE=7

# Commerce rules (PROVISIONAL — see client-decisions DEC-04/05)
TAX_RATE_BPS=500                 # 5%
SHIPPING_FLAT_PAISE=9900         # ₹99
FREE_SHIPPING_ABOVE_PAISE=200000 # ₹2000
ONLINE_RESERVATION_MINUTES=30
PRIME_PURCHASES_PER_REWARD=5

# Payments: COD is active. PhonePe stays disabled until approval (see docs/charu-pottery/phonepe-activation.md)
COD_ENABLED=true
PHONEPE_ENABLED=false
PHONEPE_ENV=sandbox              # sandbox | production
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=
PHONEPE_CLIENT_VERSION=
PHONEPE_CALLBACK_USERNAME=
PHONEPE_CALLBACK_PASSWORD=
PHONEPE_PRODUCTION_APPROVED=false

# WhatsApp (not active; DEC-07)
WHATSAPP_PROVIDER=

# Cloudinary (optional)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (password reset)
SMTP_HOST=
SMTP_PORT=
SMTP_EMAIL=
SMTP_PASSWORD=
FROM_NAME=Charu Pottery
FROM_EMAIL=
