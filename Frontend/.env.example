# Copy to .env.local for local overrides. No secrets belong in a React app.
# API base (production MUST set this, e.g. https://api.example.com/api/v1)
REACT_APP_API_URL=
# Build target: all (default) | storefront | admin
REACT_APP_APP_TARGET=all
# When storefront and admin are deployed separately:
REACT_APP_ADMIN_URL=
REACT_APP_STOREFRONT_URL=
